# Secrets
.env
.env.local
.env.*.local
!.env.example

# Node
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Python
.venv/
__pycache__/
*.py[cod]

# CopilotKit CLI project metadata (contains project ids)
.copilotkit/

# Editor / OS
.DS_Store
*.log
.temp_chunks/

# Drift reports are derived data — regenerated on every /doc-sync run.
# The snapshot itself (doc-snapshot/pages/, manifest.json, CHANGELOG.md)
# IS committed; it is the baseline every diff is taken against.
doc-snapshot/reports/

# Autorecorder scratch
autorecorder/videos/.temp_chunks/

# Autorecorder output. Recordings are build artifacts, reproducible via
# `npm run record`; see autorecorder/videos/.gitignore for why.
autorecorder/videos/*.webm
autorecorder/videos/.temp_chunks/

# Run artifacts written by the recorder — regenerated every run.
autorecorder/videos/RUN_REPORT.md
autorecorder/videos/RUN_REPORT.json
autorecorder/videos/RECORD_RESULTS.json
autorecorder/videos/logs/

# Generated after install by autorecorder/scripts/write-versions.mjs.
# It describes one run's resolved versions, so it is not a source file.
frontend/VERSIONS.md

# Stray recordings saved outside autorecorder/videos/ -- a clip dropped in the
# repo root or beside the code it shows matches none of the rules above, which
# is how a 66MB .mp4 and a 5.9MB .webm reached `git status` untracked. Video
# only: the voiceover assets in autorecorder/audio/ are .m4a and ARE committed.
*.webm
*.mp4

# The captured build output the Prebuilt Components failure clip replays. It is
# evidence, not a run artifact, so it overrides the *.log rule above.
!prior-testing/**/BUILD-ERROR.log
